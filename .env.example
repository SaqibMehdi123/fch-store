# ============================================================
# FCH — Environment template. Copy to .env and fill values.
# Never commit the real .env.
# ============================================================

# PostgreSQL (Neon-compatible in production; local dev uses sandbox Postgres 17)
DATABASE_URL="postgresql://user:password@host:5432/fch?schema=public"

# NextAuth (admin panel auth)
NEXTAUTH_URL="http://localhost:3000"
# openssl rand -base64 32
NEXTAUTH_SECRET=""

# Cloudinary (Phase 3+ — media; payment screenshots go to a PRIVATE folder)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Resend (Phase 5 — transactional email)
RESEND_API_KEY=""
EMAIL_FROM="FCH <orders@fch.pk>"

# Order-expiry cron protection (Vercel cron sends: Authorization: Bearer <secret>)
CRON_SECRET=""
